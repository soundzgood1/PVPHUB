# Libraries for the minimap button, added to the release zip by the packager
# (.pkgmeta externals). A plain git checkout has no Libs folder and the client
# warns about every missing file, so the lines stay commented out here; the
# packager strips the "# " inside this non-debug block when it builds a release.
#@non-debug@
# Libs\LibStub\LibStub.lua
# Libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
# Libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
# Libs\LibDBIcon-1.0\LibDBIcon-1.0.lua
#@end-non-debug@

# Compatibility wrappers must load before everything else — every other file
# aliases PVPHUB.Compat at its own load time.
modules\compat.lua

# Load modules first
modules\themes.lua
modules\queue_timer.lua
modules\pvp_tracking.lua

# Load main core file
PVPHUB_core.lua

# Load modules that depend on core
modules\compact.lua
modules\popups.lua
modules\ui_kit.lua
modules\cards.lua
